filebeat.inputs:
- type: log
  enabled: true
  paths:
    - /var/log/*.log
    - /var/log/syslog
    - /var/log/auth.log
    - /var/log/daemon.log
    - /var/log/kern.log
    - /var/log/pve/*.log
    - /var/log/pve-firewall.log

- type: log
  enabled: true
  paths:
    - /var/log/qemu-server/*.log
  fields:
    log_type: qemu
    
processors:
- add_host_metadata:
    when.not.contains.tags: forwarded

fields:
  log_type: proxmox
fields_under_root: false

output.logstash:
  hosts: ["{{ hostvars['k3s-master-01']['ansible_host'] }}:{{ elk.logstash.port }}"]

logging.level: info
logging.to_files: true
logging.files:
  path: /var/log/filebeat
  name: filebeat
  keepfiles: 7
  permissions: 0644
